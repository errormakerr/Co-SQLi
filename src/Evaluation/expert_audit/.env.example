# SQLi Expert Audit — configuration template
# Copy this file to `.env` (same directory) and edit the values.
# Values already set in the real environment override .env.

# Admin console password (/static/admin.html). Change this before sharing
# the tunnel URL publicly.
EXPERT_AUDIT_ADMIN_KEY=letmein

# Bind address. 0.0.0.0 lets cloudflared / LAN reach the app.
EXPERT_AUDIT_HOST=0.0.0.0
EXPERT_AUDIT_PORT=8000

# Dev-only: auto-reload on file edits. Set to 0 / false in production.
EXPERT_AUDIT_RELOAD=false

# uvicorn log level: debug | info | warning | error
EXPERT_AUDIT_LOG_LEVEL=info
