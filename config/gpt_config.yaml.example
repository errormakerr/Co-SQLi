base_url: https://your-api-endpoint/v1
api_key_env: COSQLI_LLM_API_KEY
model: YOUR_OPENAI_COMPATIBLE_MODEL
temperature: 0.5
max_tokens: 1500
# Provider-specific OpenAI-compatible fields.  Disable reasoning for short,
# format-constrained generation such as payload mutation.
extra_body:
  enable_thinking: false
